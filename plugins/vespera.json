{
  "schema_version": 1,
  "id": "vespera",
  "version": "1.1.0",
  "name": "Vespera",
  "description": "Use Singularity through Astro Bridge.",
  "category": "telescope",
  "protocol": "vespera",
  "wifi": [
    {
      "prefix": "vespera",
      "min_suffix": 0,
      "suffix": "any"
    }
  ],
  "default_address": "10.0.0.1",
  "relay": {
    "transport": "tcp",
    "ports": [
      8082,
      8083
    ]
  },
  "port_roles": [
    {
      "port": 8082,
      "role": "rest",
      "protocol": "http"
    },
    {
      "port": 8083,
      "role": "stream",
      "protocol": "socketio"
    }
  ],
  "identification": "none",
  "discovery": {
    "engine": "tcp_syn",
    "target_mode": "original"
  },
  "activity": "vespera_metadata_v1",
  "readiness": "vespera_tcp",
  "validation": {
    "level": "partial_hardware",
    "models": [
      "Vespera 2"
    ],
    "checks": [
      "wifi",
      "native_app",
      "switching"
    ],
    "limitations": [
      "images_pending",
      "autonomous_pending"
    ]
  },
  "references": [
    {
      "title": "Astro Bridge discovery evidence",
      "url": "https://github.com/Sqound/astro-bridge-core/blob/main/docs/DEVICE-DISCOVERY-STUDY.md"
    }
  ],
  "telemetry": {
    "adapters": [
      "link_v1",
      "vespera_status_v1",
      "alpaca_observer_v1"
    ],
    "default_enabled": [
      "vespera_status_v1"
    ],
    "limitation": "Read-only observations. Available values depend on the instrument and enabled adapters."
  }
}
