{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,31}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "category": {
      "enum": [
        "generic",
        "telescope",
        "mount"
      ]
    },
    "wifi": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "prefix": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          },
          "min_suffix": {
            "enum": [
              0,
              1
            ]
          },
          "suffix": {
            "enum": [
              "any",
              "alnum-hyphen",
              "alnum-hyphen-underscore"
            ]
          }
        },
        "required": [
          "prefix",
          "min_suffix",
          "suffix"
        ],
        "additionalProperties": false
      },
      "maxItems": 16
    },
    "default_address": {
      "type": [
        "string",
        "null"
      ],
      "format": "ipv4"
    },
    "relay": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "transport": {
              "enum": [
                "tcp",
                "udp"
              ]
            },
            "ports": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              },
              "maxItems": 16,
              "minItems": 1,
              "uniqueItems": true
            }
          },
          "required": [
            "transport",
            "ports"
          ],
          "additionalProperties": false
        }
      ]
    },
    "identification": {
      "enum": [
        "none",
        "seestar_scan_iscope",
        "zwo_model",
        "synscan_version"
      ]
    },
    "discovery": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "engine": {
              "enum": [
                "none",
                "seestar_scan_iscope",
                "dwarf_ping",
                "synscan_version"
              ]
            }
          },
          "required": [
            "engine"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "engine": {
              "const": "tcp_syn"
            },
            "target_mode": {
              "enum": [
                "original",
                "proxy_or_original"
              ]
            }
          },
          "required": [
            "engine",
            "target_mode"
          ],
          "additionalProperties": false
        }
      ]
    },
    "activity": {
      "enum": [
        "protect_all",
        "vespera_metadata_v1",
        "dwarf_metadata_v1",
        "seestar_metadata_v1"
      ]
    },
    "readiness": {
      "enum": [
        "association",
        "vespera_tcp"
      ]
    },
    "validation": {
      "type": "object",
      "properties": {
        "level": {
          "enum": [
            "unverified",
            "simulation",
            "partial_hardware"
          ]
        },
        "models": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "maxItems": 16
        },
        "checks": {
          "type": "array",
          "items": {
            "enum": [
              "wifi",
              "identity",
              "native_app",
              "preview",
              "switching",
              "private_proxy",
              "hotspot_proxy"
            ]
          },
          "maxItems": 7,
          "uniqueItems": true
        },
        "limitations": {
          "type": "array",
          "items": {
            "enum": [
              "physical_pending",
              "autonomous_pending",
              "guiding_pending",
              "first_discovery_unavailable",
              "images_pending",
              "switching_pending"
            ]
          },
          "maxItems": 6,
          "uniqueItems": true
        }
      },
      "required": [
        "level",
        "models",
        "checks",
        "limitations"
      ],
      "additionalProperties": false
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "url": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "format": "uri",
            "pattern": "^https://"
          }
        },
        "required": [
          "title",
          "url"
        ],
        "additionalProperties": false
      },
      "maxItems": 8,
      "minItems": 1
    },
    "onboarding": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "prefix": {
            "type": "string",
            "maxLength": 32
          },
          "target_ip": {
            "type": "string",
            "format": "ipv4"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 63
          }
        },
        "required": [
          "prefix"
        ],
        "additionalProperties": false
      },
      "maxItems": 16
    }
  },
  "required": [
    "schema_version",
    "id",
    "version",
    "name",
    "description",
    "category",
    "wifi",
    "default_address",
    "relay",
    "identification",
    "discovery",
    "activity",
    "readiness",
    "validation",
    "references"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
