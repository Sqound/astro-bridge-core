    {
      "prefix": "dwarf",
      "min_suffix": 0,
      "suffix": "any"
    }
  ],
  "default_address": null,
  "relay": {
    "transport": "tcp",
    "ports": [
      9900,
      8082,
      554
    ]
  },
  "identification": "none",
  "discovery": {
    "engine": "dwarf_ping"
  },
  "activity": "dwarf_metadata_v1",
  "readiness": "association",
