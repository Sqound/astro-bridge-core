{
  "schema_version": 1,
  "id": "seestar",
  "version": "1.1.0",
  "name": "Seestar",
  "description": "Use the Seestar app through Astro Bridge.",
  "category": "telescope",
  "protocol": "seestar",
  "wifi": [
    {
      "prefix": "seestar",
      "min_suffix": 0,
      "suffix": "any"
    },
    {
      "prefix": "s50_",
      "min_suffix": 1,
      "suffix": "any"
    },
    {
      "prefix": "s50 pro_",
      "min_suffix": 1,
      "suffix": "any"
    },
    {
      "prefix": "s30_",
      "min_suffix": 1,
      "suffix": "any"
    }
  ],
  "default_address": "10.0.0.1",
  "relay": {
    "transport": "tcp",
    "ports": [
      4700,
      4800,
      4801,
      4804,
      4554,
      4555
    ]
  },
  "port_roles": [
    {
      "port": 4700,
      "role": "control",
      "protocol": "json_rpc"
    },
    {
      "port": 4800,
      "role": "imaging",
      "protocol": "binary"
    },
    {
      "port": 4801,
      "role": "other",
      "protocol": "unknown"
    },
    {
      "port": 4804,
      "role": "other",
      "protocol": "unknown"
    },
    {
      "port": 4554,
      "role": "preview",
      "protocol": "rtsp"
    },
    {
      "port": 4555,
      "role": "preview",
      "protocol": "rtsp"
    }
  ],
  "identification": "seestar_scan_iscope",
  "discovery": {
    "engine": "seestar_scan_iscope"
  },
  "activity": "seestar_metadata_v1",
  "readiness": "tcp_connect",
  "validation": {
    "level": "partial_hardware",
    "models": [
      "Seestar S50 Pro"
    ],
    "checks": [
      "wifi",
      "native_app",
      "preview",
      "switching"
    ],
    "limitations": [
      "autonomous_pending"
    ]
  },
  "references": [
    {
      "title": "Seestar discovery evidence",
      "url": "https://github.com/Sqound/astro-bridge-core/blob/main/docs/DEVICE-DISCOVERY-STUDY.md"
    },
    {
      "title": "Seestar Wi-Fi defaults",
      "url": "https://us.seestar.com/blogs/tutorial/simulated-stargazing"
    }
  ],
  "onboarding": [
    {
      "prefix": "",
      "password": "12345678"
    }
  ],
  "telemetry": {
    "adapters": [
      "link_v1",
      "alpaca_observer_v1",
      {
        "id": "seestar_events_v1",
        "requires": "maker_key"
      }
    ],
    "default_enabled": [],
    "limitation": "Position only without your key. Stacking data needs the Seestar key."
  },
  "maker_key": {
    "family": "seestar",
    "algorithm": "rsa-pkcs1v15-sha1",
    "sources": [
      "maker_package",
      "import"
    ]
  }
}
