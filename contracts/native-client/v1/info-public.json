            "connect",
            "events-wait",
            "telemetry",
            "maker-keys"
          ],
          "openapi_url": "/api/v1/openapi.json",
          "legacy_capabilities": [
            "telescope_profiles",
            "radio_switching",
            "home_wifi",
            "wifi_scan",
            "interface_inventory",
            "hotspot",
            "settings",
            "passwords",
            "reboot",
            "connection_events",
            "safe_discovery",
            "physical_binding",
            "profile_ensure",
            "connection_operations",
            "explicit_auto_policy",
            "connection_activity",
            "client_reservations",
            "owner_locks",
            "quiet_replacement",
            "advanced_interruption_policy",
            "seestar_demand",
            "vespera_connection_demand",
            "dwarf_discovery_demand",
