{
  "name": "rate-limited-retry-after",
  "description": "Contract 1.1: a rate-limited request returns 429 with a Retry-After header and error.retry_after.",
  "contract_version": 1,
  "requires": [],
  "steps": [
    {
      "request": {
        "method": "POST",
        "path": "/api/v1/auth/token",
        "headers": {},
        "body": {
          "password": "test-password-1"
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json",
          "Cache-Control": "no-store"
        },
        "body": {
          "access_token": "test-token-1",
          "token_type": "Bearer",
          "expires_in": 43200,
          "api_version": "1"
        }
      },
      "note": "",
      "real_patterns": {
        "/access_token": "^[A-Za-z0-9_-]{20,128}$"
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/v1/system/time-hint",
        "headers": {
          "Authorization": "Bearer test-token-1"
        },
        "body": {
          "utc_iso": "2026-11-04T00:00:00Z",
          "uncertainty_ms": 500
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json",
          "Cache-Control": "no-store"
        },
        "body": {
          "clock_status": "unverified",
          "system_utc": "2026-11-04T00:00:00.000+00:00",
          "corrected_utc": "2026-11-04T00:00:00.000+00:00",
          "offset_ms": 0,
          "source": "client_hint",
          "hint_age_seconds": 0
        }
      },
      "note": "Read scope is sufficient; an already synchronized clock ignores the hint. Otherwise the last eight offsets use a median on a monotonic timeline.",
      "real_patterns": {
        "/clock_status": "^(unverified|synchronized)$",
        "/system_utc": "^\\d{4}-\\d{2}-\\d{2}T.*\\+00:00$",
        "/corrected_utc": "^\\d{4}-\\d{2}-\\d{2}T.*\\+00:00$",
        "/offset_ms": "^-?\\d+$",
        "/source": "^(client_hint|ntp)$",
        "/hint_age_seconds": "^(0|None)$"
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/v1/system/time-hint",
        "headers": {
          "Authorization": "Bearer test-token-1"
        },
        "body": {
          "utc_iso": "2026-11-04T00:00:00Z",
          "uncertainty_ms": 500
        }
      },
      "response": {
        "status": 429,
        "headers": {
          "Content-Type": "application/json",
          "Cache-Control": "no-store",
          "Retry-After": "60"
        },
        "body": {
          "error": {
            "code": "TIME_HINT_RATE_LIMITED",
            "message": "Wait 60 seconds before sending another time hint.",
            "retry_after": 60
          }
        }
      },
      "note": "Every 429 carries Retry-After (seconds) and error.retry_after; wait that long instead of retrying in a loop."
    }
  ]
}
