{
  "name": "current-time",
  "description": "Read best-effort UTC and provide an unverified hint without setting the system clock.",
  "contract_version": 1,
  "requires": [],
  "steps": [
    {
      "request": {
        "method": "POST",
        "path": "/api/v1/auth/token",
        "headers": {},
        "body": {
          "password": "test-password-1"
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json",
          "Cache-Control": "no-store"
        },
        "body": {
          "access_token": "test-token-1",
          "token_type": "Bearer",
          "expires_in": 43200,
          "api_version": "1"
        }
      },
      "note": "",
      "real_patterns": {
        "/access_token": "^[A-Za-z0-9_-]{20,128}$"
      }
    },
    {
      "request": {
        "method": "GET",
        "path": "/api/v1/system/time",
        "headers": {
          "Authorization": "Bearer test-token-1"
        },
        "body": null
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json",
          "Cache-Control": "no-store"
        },
        "body": {
          "clock_status": "unverified",
          "system_utc": "2026-11-04T00:00:00.000+00:00",
          "corrected_utc": "2026-11-04T00:00:00.000+00:00",
          "offset_ms": 0,
          "source": "lower_bound",
          "hint_age_seconds": null,
          "last_sync": {
            "kind": "never",
            "age_seconds": null,
            "this_run": false,
            "last_network_sync_utc": null
          }
        }
      },
      "note": "System UTC and corrected UTC are estimates; only sequences order records.",
      "real_patterns": {
        "/clock_status": "^(unverified|synchronized)$",
        "/system_utc": "^\\d{4}-\\d{2}-\\d{2}T.*\\+00:00$",
        "/corrected_utc": "^\\d{4}-\\d{2}-\\d{2}T.*\\+00:00$",
        "/offset_ms": "^-?\\d+$",
        "/source": "^(lower_bound|ntp)$"
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/v1/system/time-hint",
        "headers": {
          "Authorization": "Bearer test-token-1"
        },
        "body": {
          "utc_iso": "2026-11-04T00:00:00Z",
          "uncertainty_ms": 500
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json",
          "Cache-Control": "no-store"
        },
        "body": {
          "clock_status": "unverified",
          "system_utc": "2026-11-04T00:00:00.000+00:00",
          "corrected_utc": "2026-11-04T00:00:00.000+00:00",
          "offset_ms": 0,
          "source": "client_hint",
          "hint_age_seconds": 0,
          "last_sync": {
            "kind": "client_hint",
            "age_seconds": 0,
            "this_run": true,
            "last_network_sync_utc": null
          }
        }
      },
      "note": "Read scope is sufficient; an already synchronized clock ignores the hint. Otherwise the last eight offsets use a median on a monotonic timeline.",
      "real_patterns": {
        "/clock_status": "^(unverified|synchronized)$",
        "/system_utc": "^\\d{4}-\\d{2}-\\d{2}T.*\\+00:00$",
        "/corrected_utc": "^\\d{4}-\\d{2}-\\d{2}T.*\\+00:00$",
        "/offset_ms": "^-?\\d+$",
        "/source": "^(client_hint|ntp)$",
        "/hint_age_seconds": "^(0|None)$",
        "/last_sync/kind": "^(client_hint|network)$",
        "/last_sync/age_seconds": "^\\d+$",
        "/last_sync/last_network_sync_utc": "^(None|\\d{4}-\\d{2}-\\d{2}T.*\\+00:00)$"
      }
    }
  ]
}
