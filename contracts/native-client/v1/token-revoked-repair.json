{
  "name": "token-revoked-repair",
  "description": "A revoked client must pair again; a stale secret is not retried indefinitely.",
  "contract_version": 1,
  "requires": [
    "pairing"
  ],
  "steps": [
    {
      "request": {
        "method": "POST",
        "path": "/api/v1/auth/token",
        "headers": {},
        "body": {
          "client_id": "client-1",
          "client_secret": "test-token-2"
        }
      },
      "response": {
        "status": 401,
        "headers": {
          "Content-Type": "application/json",
          "Cache-Control": "no-store"
        },
        "body": {
          "error": {
            "code": "INVALID_CLIENT",
            "message": "INVALID_CLIENT"
          }
        }
      },
      "note": ""
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/v1/auth/token",
        "headers": {},
        "body": {
          "password": "test-password-1"
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json",
          "Cache-Control": "no-store"
        },
        "body": {
          "access_token": "test-token-1",
          "token_type": "Bearer",
          "expires_in": 43200,
          "api_version": "1"
        }
      },
      "note": ""
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/v1/auth/clients",
        "headers": {
          "Authorization": "Bearer test-token-1"
        },
        "body": {
          "name": "Test client",
          "scopes": [
            "read",
            "connect",
            "telemetry",
            "camera"
          ]
        }
      },
      "response": {
        "status": 201,
        "headers": {
          "Content-Type": "application/json",
          "Cache-Control": "no-store"
        },
        "body": {
          "client_id": "client-2",
          "client_secret": "test-token-4",
          "scopes": [
            "read",
            "connect",
            "telemetry",
            "camera"
          ],
          "device_id": "0123456789abcdef"
        }
      },
      "note": ""
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/v1/auth/token",
        "headers": {},
        "body": {
          "client_id": "client-2",
          "client_secret": "test-token-4"
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json",
          "Cache-Control": "no-store"
        },
        "body": {
          "access_token": "test-token-5",
          "token_type": "Bearer",
          "expires_in": 43200,
          "scopes": [
            "read",
            "connect",
            "telemetry",
            "camera"
          ]
        }
      },
      "note": ""
    }
  ],
  "real_patterns": {
    "/access_token": "^[A-Za-z0-9_-]{43}$",
    "/client_id": "^client-[a-f0-9]{24}$",
    "/client_secret": "^[A-Za-z0-9_-]{43}$",
    "/device_id": "^[a-f0-9]{16}$"
  }
}
