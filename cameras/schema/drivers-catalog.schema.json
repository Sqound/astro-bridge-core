{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "catalog_version": {
      "type": "string",
      "pattern": "^[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}\\.[0-9]{1,3}$"
    },
    "drivers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,31}$",
            "not": {
              "enum": [
                "simulator",
                "uvc"
              ]
            }
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "verified_on_hardware": {
            "type": "boolean"
          },
          "terms_url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "usb_vendors": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          },
          "indi_driver": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^indi_[a-z0-9_]{1,40}$"
          },
          "needs_firmware": {
            "type": "boolean"
          },
          "builds": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "object",
              "properties": {
                "version": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[0-9A-Za-z][0-9A-Za-z.+-]{0,31}$"
                },
                "arch": {
                  "enum": [
                    "arm64",
                    "armv6"
                  ]
                },
                "source": {
                  "enum": [
                    "download"
                  ]
                },
                "url": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^https://"
                },
                "redirect_hosts": {
                  "type": "array",
                  "maxItems": 4,
                  "uniqueItems": true,
                  "items": {
                    "type": "string"
                  }
                },
                "size": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1,
                  "maximum": 536870912
                },
                "sha256": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[0-9a-f]{64}$"
                },
                "nested": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[A-Za-z0-9._+-]+(?:/[A-Za-z0-9._+-]+){0,7}$"
                },
                "files": {
                  "type": "array",
                  "maxItems": 8,
                  "items": {
                    "type": "object",
                    "properties": {
                      "member": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9._+-]+(?:/[A-Za-z0-9._+-]+){0,7}$"
                      },
                      "sha256": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "pattern": "^[0-9a-f]{64}$"
                      },
                      "install_as": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$"
                      }
                    },
                    "required": [
                      "member",
                      "sha256",
                      "install_as"
                    ],
                    "additionalProperties": false
                  }
                },
                "license_member": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[A-Za-z0-9._+-]+(?:/[A-Za-z0-9._+-]+){0,7}$"
                },
                "license_sha256": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": [
                "version",
                "arch",
                "source",
                "url",
                "redirect_hosts",
                "size",
                "sha256",
                "nested",
                "files",
                "license_member",
                "license_sha256"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "name",
          "verified_on_hardware",
          "terms_url",
          "usb_vendors",
          "indi_driver",
          "needs_firmware",
          "builds"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "catalog_version",
    "drivers"
  ],
  "additionalProperties": false
}
